<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/btnMisProductos"
        android:layout_width="180dp"
        android:layout_height="70dp"
        android:text="Mis Productos"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnNuevoProducto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnNuevoProducto"
        android:layout_width="180dp"
        android:layout_height="70dp"
        android:text="Nuevo Producto"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/btnMisProductos"
        app:layout_constraintBottom_toTopOf="@id/btnPedidosRecibidos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnPedidosRecibidos"
        android:layout_width="180dp"
        android:layout_height="70dp"
        android:text="Pedidos Recibidos"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/btnNuevoProducto"
        app:layout_constraintBottom_toTopOf="@id/btnPerfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnPerfil"
        android:layout_width="180dp"
        android:layout_height="70dp"
        android:text="Mi Perfil"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/btnPedidosRecibidos"
        app:layout_constraintBottom_toTopOf="@id/btnCerrarSesion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnCerrarSesion"
        android:layout_width="200dp"
        android:layout_height="70dp"
        android:backgroundTint="@android:color/holo_red_dark"
        android:text="Cerrar Sesión"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/btnPerfil"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>